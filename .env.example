# Copy to .env for local development. Never commit real secrets.
# Owner role: runs migrations, owns tables (bypasses RLS as table owner).
DATABASE_OWNER_URL=postgres://fp_owner:fp_owner_dev@localhost:5432/fp_exercise
# Application role: used by the API at runtime. NOT the table owner, NO BYPASSRLS -> RLS is enforced.
DATABASE_URL=postgres://fp_app:fp_app_dev@localhost:5432/fp_exercise
# Auth service role: users/sessions/tokens only.
DATABASE_AUTH_URL=postgres://fp_auth:fp_auth_dev@localhost:5432/fp_exercise
# Superuser connection used only by `npm run db:setup` to create roles/database locally.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
PORT=8787
APP_ORIGIN=http://localhost:5173
# Private media storage directory (outside any public web root)
STORAGE_DIR=./storage
# Mail: 'outbox' writes mails to the dev outbox table/log instead of sending.
MAIL_TRANSPORT=outbox
# Push reminders: VAPID keys are generated and stored in the database when unset.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Set to 1 to switch the reminder scheduler off (e.g. on extra instances).
# DISABLE_REMINDERS=1
# Staff (therapists, admins) are logged out after this many minutes without activity (0 = off).
# Patients are never logged out for inactivity.
STAFF_IDLE_MINUTES=30

# --- WhatsApp/phone assistant (docs/AGENTS.md). Every channel is optional. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low                  # low = fastest (phone), medium/high = more thorough
AGENT_PUBLIC_URL=                  # defaults to APP_ORIGIN / RENDER_EXTERNAL_URL
AGENT_RETENTION_DAYS=90
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=             # your own secret, same value in the Meta dashboard
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_LANGUAGE=nl-NL
VOICE_NAME=Google.nl-NL-Standard-A
OWNER_WHATSAPP=                    # e.g. 31612345678 (notifications, "#bot <number>")
OWNER_PHONE=                       # e.g. +31612345678 (callers are transferred here); leave empty if that phone forwards to Twilio
PRACTICE_HOURS=                    # e.g. "ma-vr 08:00-18:00; za 09:00-12:00" (practice time zone)
AGENT_ADMIN_KEY=                   # protects POST /agents/voice/outbound
