# Copy to .env for local development. Never commit real secrets.
# Owner role: runs migrations, owns tables (bypasses RLS as table owner).
DATABASE_OWNER_URL=postgres://fp_owner:fp_owner_dev@localhost:5432/fp_exercise
# Application role: used by the API at runtime. NOT the table owner, NO BYPASSRLS -> RLS is enforced.
DATABASE_URL=postgres://fp_app:fp_app_dev@localhost:5432/fp_exercise
# Auth service role: users/sessions/tokens only.
DATABASE_AUTH_URL=postgres://fp_auth:fp_auth_dev@localhost:5432/fp_exercise
# Superuser connection used only by `npm run db:setup` to create roles/database locally.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
PORT=8787
APP_ORIGIN=http://localhost:5173
# Private media storage directory (outside any public web root)
STORAGE_DIR=./storage
# Mail: 'outbox' writes mails to the dev outbox table/log instead of sending.
MAIL_TRANSPORT=outbox
