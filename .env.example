# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low = snel (aan te raden voor telefoon), medium/high = grondiger
CLAUDE_EFFORT=low

# --- Algemeen ---
BUSINESS_FILE=business.yaml
DATABASE_PATH=data/agent.db
# Publieke https-URL van deze server (bijv. ngrok of je hosting), zonder slash aan het eind
PUBLIC_BASE_URL=https://jouw-domein.nl

# --- WhatsApp Cloud API (developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Zelf verzonnen geheim; vul hetzelfde in bij "Verify token" in het Meta-dashboard
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings > Basic) voor controle van de webhook-handtekening
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Twilio (telefoon) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+31...
TWILIO_VALIDATE_SIGNATURE=true
VOICE_LANGUAGE=nl-NL
VOICE_NAME=Google.nl-NL-Standard-A

# --- Medewerker voor overdracht ---
# WhatsApp-nummer van de eigenaar (meldingen + '#bot <nummer>' commando), bijv. 31612345678
OWNER_WHATSAPP=
# Nummer waarnaar bellers worden doorverbonden, bijv. +31612345678
OWNER_PHONE=

# --- Beveiliging uitgaande gesprekken (/voice/outbound) ---
ADMIN_API_KEY=
