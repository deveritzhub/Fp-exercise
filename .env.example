# Kopieer naar .env en vul in. Dit bestand NOOIT committen.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Standaard AI: claude of chatgpt
JARVIS_DEFAULT_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
OPENAI_MODEL=gpt-5

# Map waar je tweede brein (Markdown-notities) staat. Werkt ook met Obsidian.
JARVIS_VAULT=./brein

# Wachtwoord voor de webinterface (aanrader!)
JARVIS_PASSWORD=
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=
